# ---------------------------------------------------------------------------
# Vintage 29 Tienda — plantilla de variables de entorno
# Copiar a `.env.local` y completar con los valores reales.
# NUNCA commitear `.env` ni `.env.local` (ya están en .gitignore).
# ---------------------------------------------------------------------------

# --- Supabase (obligatorio: catálogo + panel /admin) -----------------------
# Las NEXT_PUBLIC_* viajan al navegador. La SERVICE_ROLE solo en servidor/scripts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para `pnpm seed:products --apply`. No usar en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tienda (opcional) ------------------------------------------------------
NEXT_PUBLIC_STORE_NAME=Vintage 29
NEXT_PUBLIC_STORE_WHATSAPP=
PING_MESSAGE="ping pong"
