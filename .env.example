# ---------------------------------------------------------------------------
# Vintage 29 — variables de entorno (plantilla)
# Copiar a `.env.local` y completar los valores reales. NUNCA commitear secretos.
# Ver docs/02-arquitectura.md §10 y docs/09-registros-necesarios-integracion.md.
# ---------------------------------------------------------------------------

# --- Odoo 14 Community (JSON-RPC) — solo servidor -------------------------
ODOO_URL=https://odoo.ejemplo.com
ODOO_DB=empresa_demo
ODOO_USER=integracion.tienda@ejemplo.com
ODOO_API_KEY=
# Alternativa si la instancia no soporta API Key (no usar en producción)
ODOO_PASSWORD=

# --- Culqi — la llave secreta solo en servidor ----------------------------
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=

# --- Cache / base de datos (fase de integración) --------------------------
DATABASE_URL=

# --- Config de la tienda --------------------------------------------------
NEXT_PUBLIC_STORE_NAME=Vintage 29
NEXT_PUBLIC_STORE_WHATSAPP=
STORE_ALERT_EMAIL=

# --- API interna ----------------------------------------------------------
PING_MESSAGE="ping pong"
